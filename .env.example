DATABASE_URL=postgresql+psycopg://invoice_match:invoice_match@localhost:5432/invoice_match
ACCOUNTING_CONNECTIONS_ENCRYPTION_KEY=
INVOICE_MATCH_RULES=./config/rules.yaml
INVOICE_MATCH_VENDOR_PROFILES=./config/vendor_profiles.yaml
# Use unique random tokens of at least 32 characters for each identity.
REVIEWER_TOKENS={"finance-reviewer":{"token":"replace-with-a-random-reviewer-token-at-least-32-chars","roles":["reviewer"]},"finance-manager":{"token":"replace-with-a-different-approver-token-at-least-32-chars","roles":["reviewer","approver"]},"finance-admin":{"token":"replace-with-a-different-admin-token-at-least-32-chars","roles":["reviewer","approver","admin"]}}
INTEGRATION_TOKENS={"ap-import":"replace-with-a-random-integration-token-at-least-32-chars"}
AP_ADAPTER_URL=
AP_ADAPTER_TOKEN=
# Host directory mounted as the filesystem adapter's input/output root.
AP_ADAPTER_DIRECTORY=./ap-adapter-data
AP_PROCUREMENT_ADAPTER=filesystem
AP_DELIVERY_ADAPTER=filesystem
AP_RETRY_MAX_ATTEMPTS=8
AP_RETRY_INITIAL_SECONDS=30
AP_RETRY_MAX_SECONDS=3600
DELIVERY_WORKER_NAME=invoice-match-worker
# Optional default URL and integration credential for `invoice-match capture-inbox`.
INVOICE_MATCH_API_URL=http://127.0.0.1:8000
INVOICE_MATCH_INTEGRATION_TOKEN=
INVOICE_MATCH_CAPTURE_INBOX_DIRECTORY=./invoice-inbox
# Webhook notification delivery (required by `invoice-match notifications-run`).
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WORKER_NAME=scheduler
NOTIFICATION_RETRY_MAX_ATTEMPTS=8
NOTIFICATION_RETRY_INITIAL_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=3600
# QuickBooks Online Bill export. Start in sandbox and configure entity ID maps.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
QBO_TOKEN_ENCRYPTION_KEY=
QBO_ENVIRONMENT=sandbox
QBO_VENDOR_ID_MAP={}
QBO_ITEM_ID_MAP={}
QBO_TAX_CODE_MAP={}
QBO_AP_ACCOUNT_ID=
QBO_FREIGHT_ACCOUNT_ID=
QBO_DISCOUNT_ACCOUNT_ID=

# Optional Xero Accounts Payable invoice export. Complete OAuth consent first.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
XERO_REFRESH_TOKEN=
XERO_TOKEN_ENCRYPTION_KEY=
XERO_CONTACT_ID_MAP={}
XERO_ITEM_CODE_MAP={}
XERO_TAX_TYPE_MAP={}
XERO_EXPENSE_ACCOUNT_CODE=
